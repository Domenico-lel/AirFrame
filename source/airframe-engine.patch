+/* AirFrame integration: machine-readable events. No media is persisted. */
+static void af_text(const char *event, const char *value) {
+    if (!getenv("AIRFRAME_WINDOW")) return;
+    const char *v = value ? value : "";
+    gchar *encoded = g_base64_encode((const guchar *)v, strlen(v));
+    printf("@AF %s %s\n", event, encoded);
+    fflush(stdout);
+    g_free(encoded);
+}
